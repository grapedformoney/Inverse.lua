local function sahur()
    if not game:IsLoaded() then return false end;
    local ch = lp.Character;
    if not ch or not ch.Parent then return false end;
    local hum = ch:FindFirstChildOfClass("Humanoid");
    if not hum or hum.Health <= 0 then return false end;
    local hrp = ch:FindFirstChild("HumanoidRootPart");
    if not hrp or not hrp.Parent then return false end;
    if not ch:FindFirstChild("ViewmodelController") then return false end;
    if not ch:FindFirstChild("InventoryController") then return false end;
    local remotes = rs:FindFirstChild("Remotes");
    if not remotes then return false end;
    local hasobf = false;
    for _, c in ipairs(remotes:GetChildren()) do
        if c:IsA("Folder") and #c.Name > 10 then
            for _, g in ipairs(c:GetChildren()) do
                if g:IsA("RemoteEvent") or g:IsA("UnreliableRemoteEvent") then
                    hasobf = true;
                    break;
                end;
            end;
        end;
        if hasobf then break end;
    end;
    if not hasobf then return false end;
    local stamp = ch:GetAttribute("sahur");
    local now = tick();
    if not stamp then
        ch:SetAttribute("sahur", now);
        return false;
    end;
    return (now - stamp) >= 2;
end;

